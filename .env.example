# Copia este archivo a .env.local y completa con los datos de tu proyecto Supabase
# (Project Settings → API en supabase.com)

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Service role (secreta) — necesaria para crear/borrar usuarios de despachador
# desde el panel (Project Settings → API → service_role). NUNCA con prefijo
# NEXT_PUBLIC_, nunca se expone al navegador, úsala solo en rutas de servidor.
SUPABASE_SERVICE_ROLE_KEY=

# Geocodificación — orden de preferencia: Mapbox > Geodir > Nominatim (respaldo
# automático si no configuras ninguna clave, así que no son obligatorias para arrancar).
# OJO: sin el prefijo NEXT_PUBLIC_ a propósito — se usan solo del lado del servidor.

# Mapbox (recomendado, servicio activo): consigue tu token en https://account.mapbox.com/access-tokens/
MAPBOX_TOKEN=

# Geodir (docs.geodir.co): especializado en Mz/Lote/urbanizaciones de Perú, pero
# su sistema de cuentas está fallando al momento de escribir esto. Déjala vacía
# si no consigues clave — no bloquea nada.
GEODIR_API_KEY=

# Claude (Anthropic) — necesaria para "Leer etiqueta con foto" e "Importar por
# fotos". Consíguela en console.anthropic.com → API Keys. Server-only, nunca
# con prefijo NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
